{
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=HelpDesk;User=root;Password=123456;"
  },
  "JwtSettings": {
    "Key": "HelpDesk-Super-Secret-Key-For-Jwt-Token-2026-!@#$%",
    "Issuer": "HelpDesk",
    "Audience": "HelpDesk",
    "ExpiryMinutes": 120
  },
  "Cors": {
    "Origins": "http://localhost:5173"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
